#!/bin/sh

# Executed as root during plugin uninstall. LoxBerry stores a copy of this
# script outside the plugin at install time and runs it with the usual
# arguments:
#   command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# It reverses what the plugin set up. vzlogger and the Volkszaehler apt
# repository are only removed when the plugin installed vzlogger itself, marked
# by config/plugins/<folder>/vzlogger.installed-by-plugin (written by
# postroot.sh). If vzlogger was already present before the plugin was
# installed, it is left untouched.
#
# LoxBerry treats an exit code > 1 as fatal and aborts the whole uninstall, so
# every step is tolerant and the script always ends with "exit 0".

ARGV3=$3 # Plugin installation folder (e.g. smartmeter-ng)
ARGV5=$5 # Base folder of LoxBerry

UDEV_RULE="/etc/udev/rules.d/99-smartmeter.rules"
RUNTIME_DIR="/var/run/shm/$ARGV3"
VZLOGGER_MARKER="$ARGV5/config/plugins/$ARGV3/vzlogger.installed-by-plugin"

# These paths mirror the ones written by bin/vzlogger_pkg.sh. Keep them in sync.
SOURCE_LIST="/etc/apt/sources.list.d/volkszaehler-volkszaehler-org-project.list"
KEYRING="/usr/share/keyrings/volkszaehler-volkszaehler-org-project-archive-keyring.gpg"
POLICY_BACKUP="/usr/sbin/policy-rc.d.smartmeter-ng"

# Stop vzlogger through the plugin watchdog while the plugin files are still
# present, then make sure the packaged service is not left masked or running.
WATCHDOG="$ARGV5/bin/plugins/$ARGV3/watchdog.pl"
if [ -x "$WATCHDOG" ]; then
    echo "<INFO> Stopping vzlogger through the plugin watchdog"
    su loxberry -c "$WATCHDOG --action=stop" >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl unmask vzlogger.service >/dev/null 2>&1 || true
    systemctl stop vzlogger.service >/dev/null 2>&1 || true
    systemctl disable vzlogger.service >/dev/null 2>&1 || true
    systemctl reset-failed vzlogger.service >/dev/null 2>&1 || true
fi

if [ -f "$VZLOGGER_MARKER" ]; then
    echo "<INFO> vzlogger was installed by the plugin - removing it and the Volkszaehler repository"

    if command -v dpkg-query >/dev/null 2>&1 && \
       dpkg-query -W -f='${Status}' vzlogger 2>/dev/null | grep -q "install ok installed"; then
        echo "<INFO> Purging the vzlogger package"
        DEBIAN_FRONTEND=noninteractive apt-get purge -y vzlogger \
            || echo "<WARNING> Could not purge the vzlogger package"
    fi

    echo "<INFO> Removing the Volkszaehler apt repository"
    rm -f "$SOURCE_LIST" "$KEYRING"
    rm -f "$VZLOGGER_MARKER"

    if command -v apt-get >/dev/null 2>&1; then
        apt-get update >/dev/null 2>&1 || true
    fi
else
    echo "<INFO> vzlogger was present before the plugin - leaving the package and repository in place"
fi

rm -f "$POLICY_BACKUP"

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ -f "$UDEV_RULE" ] && grep -q "LoxBerry SML-eMon Plugin device rule file" "$UDEV_RULE"; then
    echo "<INFO> Removing the Smartmeter udev rule"
    rm -f "$UDEV_RULE"
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger >/dev/null 2>&1 || true
    fi
fi

if [ -d "$RUNTIME_DIR" ]; then
    echo "<INFO> Removing the Smartmeter runtime cache"
    rm -rf "$RUNTIME_DIR"
fi

exit 0
